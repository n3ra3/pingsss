# Copy to .env for local runs (or set these in the Render dashboard).
# .env is gitignored; keep REAL secrets there, never in this template.
BOT_TOKEN=123456:ABCDEF_your_bot_token_from_BotFather
OWNER_CHAT_ID=            # your Telegram chat id; leave empty first, the bot tells you
DATABASE_URL=            # postgresql://user:pass@host/db?sslmode=require  (empty = local SQLite)
CURRENCY=1               # 1 = USD
COUNTRY=US
DEFAULT_PROFIT_PCT=20    # alert when Steam->PirateSwap profit >= this %
PS_FEE_PCT=10            # subtract this %% from the PirateSwap price before profit
POLL_INTERVAL=600        # seconds between full check cycles (600 = every 10 min)
REQUEST_DELAY=8          # seconds between per-item Steam requests
STEAM_COOLDOWN=600       # pause (s) after a Steam 429 so the rate limit clears
MAX_PAGES=50             # max search pages to scan per item (stops early at total_count)
STEAM_COOKIE=            # optional: paste your steamLoginSecure=... cookie for higher limits
PORT=10000
